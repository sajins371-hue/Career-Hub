NODE_ENV=development
PORT=5000
APP_NAME=CareerHub
MONGO_URI=mongodb://localhost:27017/career_hub
JWT_SECRET=change_this_to_a_long_random_value_at_least_32_chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS. The Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173

# Recruiter accounts use the admin approval workflow exposed at /admin/recruiter-requests.

# Base URL of the frontend. Used to build the links inside verification / password-reset emails.
# Must match where the frontend actually runs (Vite default: http://localhost:5173).
CLIENT_URL=http://localhost:5173

# ---- Email (SMTP) --------------------------------------------------------------------
# Leave SMTP_HOST/USER/PASS blank to run without email: the verification/reset links are then
# printed in the backend console instead. Test your settings with:  npm run test-email
#
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#          SMTP_USER=you@gmail.com   SMTP_PASS=<16-char APP PASSWORD, not your login password>
#          (Google Account > Security > 2-Step Verification > App passwords)
# Outlook: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587  SMTP_SECURE=false
# Port 465 is always treated as secure (SSL); use SMTP_SECURE=false with 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional. If blank, "<APP_NAME> <SMTP_USER>" is used. Must match SMTP_USER for Gmail/Outlook.
MAIL_FROM=

# Optional external integrations (leave blank to run with stubs/heuristics only)

# ---- FREE AI option: any OpenAI-compatible endpoint (takes priority over the keys below) ----
# Google Gemini free tier (key from https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<your Gemini key>
#   LLM_MODEL=gemini-2.5-flash        (use a Flash model that AI Studio lists for your key)
# Ollama running on your own computer (no key, no cost; install from https://ollama.com,
# then run `ollama pull llama3.2`):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_MAX_TOKENS=2000
# LLM_TIMEOUT_MS=60000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
LINKEDIN_JOBS_API_KEY=
